# Copy this file to ".env" and fill in your key. Never commit the real ".env".
# The app reads ".env" from this folder first, then from the folder above it.
PORTKEY_API_KEY=

# Optional (the defaults are fine):
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
# PORTKEY_PROVIDER=openai
# USE_LIVE_DATA=0   # use only the saved data in data/cache (no internet lookups for sales, routes, weather)
# PORT=8000
